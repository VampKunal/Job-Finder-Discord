# Discord Webhook URL for channel notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Groq API Key (for LLM relevance scoring)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Upstash Redis REST Credentials (for job deduplication)
# Get your free instance at: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Minimum score threshold to trigger Discord push (Default: 6)
MIN_SCORE_THRESHOLD=6

# (Optional) Jina Reader API Key for full HTML-to-Markdown job page extraction
JINA_API_KEY=jina_your_api_key_here
